<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="/css/site.css" rel="stylesheet"/></head><body><nav class="navbar navbar-dark bg-dark navbar-expand"><div class="container"><a class="navbar-brand" href="/">🏁 RaceDay</a><div class="navbar-nav ms-auto">@if(Context.Session.GetString("role")=="Organiser"){<a class="nav-link" href="/Organiser">Dashboard</a><a class="nav-link" href="/Organiser/CreateEvent">Create event</a>}@if(Context.Session.GetString("role")=="Participant"){<a class="nav-link" href="/Participant">Events</a><a class="nav-link" href="/Participant/MyEvents">My enrolments</a><a class="nav-link" href="/Participant/MyResults">Results</a>}@if(Context.Session.GetString("uid")!=null){<a class="nav-link" href="/Account/Logout">Logout</a>}else{<a class="nav-link" href="/Account/Login">Login</a><a class="nav-link" href="/Account/Register">Register</a>}</div></div></nav><main class="container py-4">@if(TempData["msg"]!=null){<div class="alert alert-success">@TempData["msg"]</div>}@if(TempData["err"]!=null){<div class="alert alert-danger">@TempData["err"]</div>}@RenderBody()</main></body></html>

@model CreateEventForm
<h1>Create event</h1><div asp-validation-summary="All" class="text-danger"></div><form method="post" enctype="multipart/form-data" class="panel">@foreach(var f in new[]{"Name","Description","EventDate","Location","Distance"}){<label>@f</label><input name="@f" class="form-control mb-2" required/>}<label>Event type</label><select asp-for="EventType" class="form-select mb-2"><option value="run">Run</option><option value="walk">Walk</option><option value="cycle">Cycle</option></select><label>Banner image</label><input name="Banner" type="file" accept="image/*" class="form-control mb-3"/><button class="btn btn-race">Save event</button></form>
